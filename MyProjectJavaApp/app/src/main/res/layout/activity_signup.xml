<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTitle121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edtFullName121"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Full Name"
            android:background="@drawable/edit_text_background_121"
            android:padding="10dp"
            android:inputType="textPersonName"
            android:textColor="@color/black"
            android:textColorHint="@color/hint_text_color"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtEmail121"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Email"
            android:background="@drawable/edit_text_background_121"
            android:padding="10dp"
            android:inputType="textEmailAddress"
            android:textColor="@color/black"
            android:textColorHint="@color/hint_text_color"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtPhone121"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Phone"
            android:background="@drawable/edit_text_background_121"
            android:padding="10dp"
            android:inputType="phone"
            android:textColor="@color/black"
            android:textColorHint="@color/hint_text_color"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtPassword121"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Password"
            android:background="@drawable/edit_text_background_121"
            android:padding="10dp"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/hint_text_color"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtConfirmPassword121"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Confirm Password"
            android:background="@drawable/edit_text_background_121"
            android:padding="10dp"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/hint_text_color"
            android:layout_marginBottom="20dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSignUp121"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SIGN UP"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_background_121"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/loginRedirectLayout121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txtHaveAccount121"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account?"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtSignIn121"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sign In"
                android:paddingStart="4dp"
                android:textColor="@color/light_sea_blue"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtOr121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Or sign up with"
            android:textColor="@color/black"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/socialButtonsLayout_121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/facebookButton_121"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_weight="0"
                android:layout_marginEnd="16dp"
                android:background="@drawable/social_button_background_121"
                android:drawableStart="@drawable/ic_facebook"
                android:paddingStart="12dp"
                android:paddingEnd="0dp"
                android:text="Facebook"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/googleButton_121"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="0dp"
                android:layout_weight="0"
                android:background="@drawable/social_button_background_121"
                android:drawableStart="@drawable/ic_google"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:text="Google"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
