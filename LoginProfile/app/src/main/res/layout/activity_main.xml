<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="32dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textViewTitle121"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ĐĂNG NHẬP"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="64dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutUsername121"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_person_24"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxStrokeColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle121">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextUsername121"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên người dùng 121"
            android:inputType="textPersonName"
            android:imeOptions="actionNext"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:textColorHint="#A0A0A0" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutPassword121"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_lock_24"
        app:endIconMode="password_toggle"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxStrokeColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutUsername121">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextPassword121"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mật khẩu 121"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:textColorHint="#A0A0A0" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/buttonLogin121"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:text="Đăng nhập"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@android:color/black"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutPassword121" />

    <TextView
        android:id="@+id/textViewForgotPassword121"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quên mật khẩu?"
        android:textColor="#808080"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonLogin121" />

</androidx.constraintlayout.widget.ConstraintLayout>
